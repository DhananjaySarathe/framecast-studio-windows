#include <windows.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/Framecast.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Dhananjay Sarathe"
      VALUE "FileDescription", "Framecast Studio"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "FramecastStudio"
      VALUE "OriginalFilename", "FramecastStudio.exe"
      VALUE "ProductName", "Framecast Studio"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
